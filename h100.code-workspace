{
  "folders": [
    {
      "name": "sovereign-engine-v2",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/*.pyc": true
    },
    "editor.restoreViewState": true,
    "workbench.editor.restoreViewState": true
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "leanprover.lean4",
      "13xforever.language-x86-64-assembly"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Train Graph Transformer",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/train_graph_transformer.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Train (200 steps)",
        "type": "shell",
        "command": "python train_graph_transformer.py",
        "options": { "cwd": "${workspaceFolder}" },
        "group": { "kind": "build", "isDefault": true },
        "presentation": { "reveal": "always", "panel": "shared" }
      }
    ]
  },
  "remoteExplorer.restoreExplorerState": true,
  "workbench.editor.openFiles": [
    "train_graph_transformer.py",
    "forth-array-transformer/virtual_h100_pipeline.py",
    "forth-array-transformer/virtual_h100.fs",
    "forth-array-transformer/libavx512nn.asm",
    "forth-array-transformer/ga144_hardware_forth.asm",
    "forth-array-transformer/colorforth_env.asm",
    "forth-array-transformer/native_tensor_dispatch.c",
    "forth-array-transformer/zero_copy_dpdk.c",
    "forth-array-transformer/tensor_engine.q",
    "forth-array-transformer/freehand_tensor_siphon.als",
    "forth-array-transformer/freehand_tensor_siphon.lean",
    "jax_training_harness/jax_training_harness/jax_harness/algorithms/trainer.py",
    "jax_training_harness/jax_training_harness/jax_harness/algorithms/optim.py",
    "jax_training_harness/jax_training_harness/jax_harness/data/generators.py",
    "jax_training_harness/jax_training_harness/jax_harness/config.py",
    "jax_training_harness/jax_training_harness/jax_harness/protocols.py",
    "jax_training_harness/jax_training_harness/jax_harness/types.py"
  ]
}
